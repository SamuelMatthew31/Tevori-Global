{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tevori-global",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  }
}
